# Next.js (Vercel and local frontend)
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local
# Seed-only value; keep private and unset outside an explicit demo setup.

# Demo bootstrap and security scripts only; never expose these in the browser
NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1
NHOST_GRAPHQL_URL=https://local.graphql.local.nhost.run/v1
NHOST_ADMIN_SECRET=replace-with-your-local-or-cloud-admin-secret
DEMO_PASSWORD=
DEMO_NOTIFICATION_EMAIL=you@example.com

# Nhost Cloud function secrets (configure in the Nhost dashboard)
GEMINI_API_KEY=replace-with-gemini-key
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=AgentWeave <notifications@your-verified-domain.example>
